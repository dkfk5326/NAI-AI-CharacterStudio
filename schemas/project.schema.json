          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Term"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "identity",
              "appearance",
              "outfit",
              "expression",
              "pose",
              "gaze",
              "prop",
              "action"
            ]
          },
          "title": "Groups",
          "type": "object"
        },
        "undesired": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "maxItems": 100,
          "title": "Undesired",
          "type": "array"
        },
        "notes_ko": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Notes Ko",
          "type": "array"
        }
      },
      "required": [
        "id",
        "groups"
      ],
      "title": "CharacterIR",
      "type": "object"
    },
    "CharacterInput": {
      "additionalProperties": false,
