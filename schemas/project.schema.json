          "propertyNames": {
            "enum": [
              "identity",
              "appearance",
              "outfit",
              "expression",
              "pose",
              "gaze",
              "prop",
              "action"
            ]
          },
          "title": "Fields",
          "type": "object"
        },
        "locked_groups": {
          "items": {
            "enum": [
              "identity",
              "appearance",
              "outfit",
              "expression",
              "pose",
              "gaze",
              "prop",
              "action"
            ],
            "type": "string"
          },
          "title": "Locked Groups",
          "type": "array"
